.venv/
venv/
.DS_Store
__pycache__/
*.pyc
*.pth
.idea/
.vscode/
*.egg-info/
build/
dist/
outputs/*
!outputs/flowconx_final_labeled_kpi_pass/
!outputs/flowconx_final_labeled_kpi_pass/flowconx_checkpoint.pt
!outputs/flowconx_final_labeled_kpi_pass/history.json
!outputs/flowconx_final_labeled_kpi_pass/metrics.json
!outputs/flowconx_final_labeled_kpi_pass/kpi_report.md
!outputs/flowconx_final_labeled_kpi_pass/eval.json
# Raw archives and derived datasets are never committed. The archives are
# 3.2 GB and 21 GB; the derived CSVs are hundreds of megabytes and are fully
# reproducible from them via `make data`. What IS committed is the manifest
# (results/data/*_manifest.json), which records the archive checksum, the
# loader configuration and the per-capture statistics, so a reviewer can
# verify that a regenerated dataset matches the one behind the numbers.
data/raw/
data/processed/
data/*.csv
data/*.parquet
data/*.pcap
data/*.pcapng

# Audit artifacts are committed: they are the evidence behind every table.
# Split manifests (gzipped flow-ID lists + SHA256) and small result JSON only.
!results/
!results/**/*.json
!results/**/*.md
# Checkpoints from `make repro-full --save-model` stay local: 5.7 MB each
# across 132 runs. The metrics they produced are what gets committed.
results/**/model.pt
!splits/
!splits/**/*.json
!splits/**/*.json.gz

# Never commit raw captures or checkpoints beyond the one reference run.
*.pcap
*.pcapng
*.pt
!outputs/flowconx_final_labeled_kpi_pass/flowconx_checkpoint.pt

# `make repro-small` writes here so it cannot collide with the committed
# full-budget results.
results-small/

# Test and build noise
.pytest_cache/
.ruff_cache/
.mypy_cache/
